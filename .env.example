# Absolute or relative to WikiMaxx repo root
# Sibling MaxxOps docs checkout (CONTENT_ROOT = wiki site)
CONTENT_ROOT=../maxxops_documentation/wiki
# Users JSON store (path may end in .sqlite — app writes .json alongside)
USERS_PATH=data/users.json
# Role catalog (soft-FK vs users / _access.json)
ROLES_PATH=data/roles.json
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: used by bin/seed-admin.php when creating the first admin
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com
